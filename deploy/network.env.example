# Copy this file to network.env (kept out of git) and fill in real values,
# then run: sudo bash pi-network-setup.sh

# The known local Wi-Fi network to join automatically when in range.
HOME_WIFI_SSID=YourHomeNetwork
HOME_WIFI_PASSWORD=your-home-wifi-password

# The fallback hotspot the Pi broadcasts when HOME_WIFI_SSID isn't found.
HOTSPOT_SSID=Scion-Pi
HOTSPOT_PASSWORD=choose-a-password

# Wi-Fi interface to use (usually wlan0 on Raspberry Pi).
WIFI_IFACE=wlan0

# Seconds to wait for the home Wi-Fi to connect at boot before starting
# the hotspot instead.
FALLBACK_TIMEOUT=25
